# ── ChainSleuth Backend – Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Blockchain & Archive RPCs ────────────────────────────────────────────────
TRONGRID_KEY=your_trongrid_api_key_here
# Optional Archive RPCs (leaves default if empty)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
MEMPOOL_API_URL=https://mempool.space/api

# ── Commercial Threat Intelligence (Optional) ────────────────────────────────
# If left blank, ChainSleuth automatically uses its built-in OSINT & VASP registry
TRM_API_KEY=your_trm_labs_api_key_here
CHAINALYSIS_API_KEY=your_chainalysis_api_key_here
ELLIPTIC_API_KEY=your_elliptic_api_key_here

# ── Auth0 & Identity Management (Optional) ───────────────────────────────────
# Create a free tenant at https://manage.auth0.com/
AUTH0_DOMAIN=dev-xyz.us.auth0.com
AUTH0_AUDIENCE=https://api.chainsleuth.in
AUTH_ENABLED=false

# ── AI / LLM ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Neo4j (Community Edition 5.x) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ChainSleuth
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
